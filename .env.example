# Copy this file to ".env" (same folder) and fill in the values.
# The .env file is read only by the backend. Nothing here reaches the browser.

# --- Claude (required for chat) ---------------------------------------------
ANTHROPIC_API_KEY=your_api_key_here
# Any Claude model your key can use. Leave the placeholder to use the default
# (claude-opus-5-5).
ANTHROPIC_MODEL=your_supported_claude_model

# Optional: low | medium | high | xhigh | max. Empty = the model's own default.
# Leave empty for models that do not support the effort setting.
ANTHROPIC_EFFORT=
# Optional: maximum tokens per Claude response (thinking included).
ANTHROPIC_MAX_TOKENS=16000
# Optional: if the model declines a request for safety-policy reasons, let the
# API retry it on a fallback model (beta feature; only used with models that
# support it). Set to false to disable.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Image reader (Claude vision) --------------------------------------------
# An attached X-ray, scan or photo is sent to Claude in a separate request and
# described for the assistant (backend/services/image_reader_service.py).
IMAGE_READER_ENABLED=true
IMAGE_READER_MAX_TOKENS=4000

# --- Image triage (optional; local vision transformer) -----------------------
# Every uploaded image is labelled on the server as xray / scan / document /
# photo by a zero-shot CLIP vision transformer, so the assistant calls the
# right tool without asking what the picture is. The weights (about 600 MB)
# are downloaded once from the Hugging Face hub into IMAGE_TRIAGE_CACHE_DIR;
# the pictures themselves never leave the server. Set to false to skip the
# download and let the assistant decide from the message alone.
IMAGE_TRIAGE_ENABLED=true
IMAGE_TRIAGE_MODEL=openai/clip-vit-base-patch32
# Labels below this confidence are reported as "unknown".
IMAGE_TRIAGE_MIN_CONFIDENCE=0.5
IMAGE_TRIAGE_TIMEOUT_SECONDS=20
IMAGE_TRIAGE_CACHE_DIR=./models/triage

# --- Doctor search on superdoc.bg (optional) ---------------------------------
# Set to false to remove the find_doctors tool.
SUPERDOC_ENABLED=true
SUPERDOC_TIMEOUT_SECONDS=12

# --- Limits (optional) -------------------------------------------------------
MAX_TOOL_ITERATIONS=4
TOOL_TIMEOUT_SECONDS=60
CLAUDE_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=10
IMAGE_TTL_MINUTES=60

# --- HTTP (optional) ---------------------------------------------------------
# Origins allowed to call the API (comma separated).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Medication reference on framar.bg (optional) -----------------------------
# Leaflets, active-ingredient pages and interaction checks. Only the medicine
# name is sent. Set to false to remove the lookup_medication tool.
FRAMAR_ENABLED=true
FRAMAR_TIMEOUT_SECONDS=12

# --- Medical document reader (optional) ----------------------------------------
# Sends a document the user asks to be read (photo or PDF) to the Claude API.
# Set to false to remove the read_document tool; PDFs can then still be
# attached but nothing will read them.
DOCUMENT_READER_ENABLED=true
MAX_PDF_PAGES=10
DOCUMENT_MAX_TOKENS=8000

# --- Docker / Railway ----------------------------------------------------------
# The Dockerfile at the project root builds ONE image: the frontend as static
# files, served by this backend from "/", plus the triage model. Inside it the
# paths are already set: FRONTEND_DIST=/app/frontend_dist and
# IMAGE_TRIAGE_CACHE_DIR=/app/models/triage.
# On Railway, set the variables in the service, not in a .env file.
# Outside Docker, FRONTEND_DIST (default ./frontend/out) is served when it exists,
# i.e. after `npm run build` in frontend/; during development use `next dev`.
